# ==============================================================================
# PARI TRENDS — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Configure these variables in your deployment host (e.g. Vercel, Netlify, Cloudflare).

# Canonical URL of the production site (used for OpenGraph, sitemap, and robots.txt)
NEXT_PUBLIC_SITE_URL=https://paritrends.com

# WhatsApp business phone number in international format with country code (e.g. 919876543210)
# Leave empty to automatically fallback to #visit on all enquiry CTA buttons
NEXT_PUBLIC_WHATSAPP_NUMBER=
